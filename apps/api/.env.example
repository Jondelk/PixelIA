# Entorno: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=4000

# Conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/pixel

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Nivel de log: debug | info | warn | error | silent
LOG_LEVEL=info

# Secreto para firmar los JWT de sesión (mínimo 32 caracteres). Obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión en días
SESSION_TTL_DAYS=7

# Coste de bcrypt (12 recomendado; 4 solo en tests)
BCRYPT_ROUNDS=12

# Proveedor de IA: anthropic | demo. Si se omite: anthropic cuando hay ANTHROPIC_API_KEY, si no demo
# (demo = respuestas locales sin IA, útil para desarrollo y tests).
AI_PROVIDER=
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=90000

# Mensajes previos que Pixel recuerda en cada conversación
CHAT_HISTORY_LIMIT=20
