# Entorno: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=4000

# Conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/pixel

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Nivel de log: debug | info | warn | error | silent
LOG_LEVEL=info

# Secreto para firmar los JWT de sesión (mínimo 32 caracteres). Obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión en días
SESSION_TTL_DAYS=7

# Coste de bcrypt (12 recomendado; 4 solo en tests)
BCRYPT_ROUNDS=12

# Proveedor de IA: anthropic | demo. Si se omite: anthropic cuando hay ANTHROPIC_API_KEY, si no demo
# (demo = respuestas locales sin IA, útil para desarrollo y tests).
AI_PROVIDER=
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=90000

# Mensajes previos que Pixel recuerda en cada conversación
CHAT_HISTORY_LIMIT=20

# Zona horaria IANA para los Pixels que aún no tienen una (define el "hoy" del Daily Director)
DEFAULT_TIMEZONE=America/Bogota

# Google Calendar (Prompt 19, solo Pixel Personal; ver docs/GOOGLE-CALENDAR.md). Opcional: vacío =
# herramienta "sin configurar" y el resto de Pixel funciona igual. Credenciales de un cliente OAuth
# "Aplicación web" de Google Cloud; nunca las subas al repositorio.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir con la URL autorizada en Google. En desarrollo, a través del proxy de Vite:
# http://localhost:5173/api/calendar/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Clave que cifra los tokens en MongoDB (AES-256-GCM): 32 bytes en base64.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Solo pruebas en vivo con escritura: un calendario de PRUEBA dedicado (nunca el principal) y un
# refresh token de prueba para él (test/googleCalendar.live.test.ts; sin ellos queda SKIPPED).
GOOGLE_CALENDAR_TEST_CALENDAR_ID=
GOOGLE_CALENDAR_TEST_REFRESH_TOKEN=
